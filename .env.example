# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# `PUBLIC_*` vars are bundled into the client. Never put secrets there.

# -----------------------------------------------------------------------------
# Supabase (Stage 3+)
# -----------------------------------------------------------------------------
# Local values are printed by `supabase start`. Replace with hosted values in prod.

PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=replace-me-with-anon-key-from-supabase-start

# Server-only. Used by edge functions / GitHub Actions / admin tooling.
# NEVER expose this to the browser. NEVER commit a real value.
SUPABASE_SERVICE_ROLE=replace-me-with-service-role-key

# -----------------------------------------------------------------------------
# Cloudflare Turnstile
# -----------------------------------------------------------------------------
# Single shared widget across local + staging + future production. Allowed
# hostnames: localhost, 127.0.0.1, staging.mapadeautoras.com, mapadeautoras.com,
# www.mapadeautoras.com. Use the real site key + secret here; Cloudflare's
# always-passing test keys (1x000...000AA / 1x000...000AA) work too but skip
# real bot challenge logic.

PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Resend — notify_submitter Edge Function (Stage 8)
# -----------------------------------------------------------------------------
# Real Resend API key (free tier at resend.com). Absent in local dev = the
# notify_submitter function short-circuits with a warning instead of sending.

RESEND_API_KEY=

# From-address for outbound emails. Staging (Resend unverified account):
#   onboarding@resend.dev  — only sends to the account owner's email.
# Prod (Stage 9b, mapadeautoras.com domain-authed in Resend):
#   hola@mapadeautoras.com
RESEND_FROM_EMAIL=

# (RESEND_AUDIENCE_ID intentionally removed — Stage 8 is transactional only.
# Broadcast/audience sync deferred to post-launch backlog.)

# -----------------------------------------------------------------------------
# Site URL (Stage 8 — notify_submitter)
# -----------------------------------------------------------------------------
# Rendered as the "See the map" link inside the submitter notification email.
# Staging: https://staging.mapadeautoras.com
# Prod   : https://mapadeautoras.com

SITE_URL=

# -----------------------------------------------------------------------------
# Owner / admin
# -----------------------------------------------------------------------------
# Email that receives new-suggestion notifications.

OWNER_NOTIFICATION_EMAIL=

# -----------------------------------------------------------------------------
# Site URL (Stage 7a)
# -----------------------------------------------------------------------------
# Used by the notify_owner Edge Function to build deep-links into the admin
# inbox (e.g. `${PUBLIC_SITE_URL}/admin/suggestions/<id>`).
#
# Local dev: http://localhost:4321
# Production: https://mapadeautoras.com

PUBLIC_SITE_URL=http://localhost:4321

# -----------------------------------------------------------------------------
# DeepL (Stage 7b-i)
# -----------------------------------------------------------------------------
# Used by supabase/functions/translate to power the "Traducir" button in the
# admin promote form. Free tier = 500k chars/month at api-free.deepl.com.
# Sign up at https://www.deepl.com/pro-api — pick the FREE plan.
# Without a key set, the button errors gracefully ("translation_failed") and
# the owner can type EN manually.

DEEPL_API_KEY=

# -----------------------------------------------------------------------------
# Hosted environments (staging / production) — NOT set in this file
# -----------------------------------------------------------------------------
# These variables are set in dashboards, never committed:
#
#   PUBLIC_SUPABASE_URL          → Cloudflare Pages env vars (Production scope)
#   PUBLIC_SUPABASE_ANON_KEY     → Cloudflare Pages env vars (Production scope)
#   PUBLIC_TURNSTILE_SITE_KEY    → Cloudflare Pages env vars (Production scope)
#   NODE_VERSION                 → Cloudflare Pages env vars (Production scope) — must be 22+
#   TURNSTILE_SECRET_KEY         → Supabase function settings (per project)
#   DEEPL_API_KEY                → Supabase function settings (per project)
#   RESEND_API_KEY               → Supabase function settings (production only — Stage 9b)
#   STAGING_SUPABASE_URL         → GitHub Actions secrets (heartbeat workflow)
#   STAGING_SUPABASE_ANON_KEY    → GitHub Actions secrets (heartbeat workflow)
#
# See docs/30-ops/staging-deploy.md for the full inventory + key rotation.
