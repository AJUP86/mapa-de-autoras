# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# `PUBLIC_*` vars are bundled into the client. Never put secrets there.

# -----------------------------------------------------------------------------
# Supabase (Stage 3+)
# -----------------------------------------------------------------------------
# Local values are printed by `supabase start`. Replace with hosted values in prod.

PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=replace-me-with-anon-key-from-supabase-start

# Server-only. Used by edge functions / GitHub Actions / admin tooling.
# NEVER expose this to the browser. NEVER commit a real value.
SUPABASE_SERVICE_ROLE=replace-me-with-service-role-key

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (Stage 6)
# -----------------------------------------------------------------------------
# Public site key (safe to ship to the browser). Secret stays server-side.
#
# For local development, use Cloudflare's always-passing TEST KEYS:
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Swap to real keys (from https://dash.cloudflare.com → Turnstile) at Stage 9.

PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Resend (Stage 8)
# -----------------------------------------------------------------------------
# Transactional email + newsletter broadcasts. Server-only.

RESEND_API_KEY=
RESEND_FROM_EMAIL=hola@mapadeautoras.com
RESEND_AUDIENCE_ID=

# -----------------------------------------------------------------------------
# Owner / admin
# -----------------------------------------------------------------------------
# Email that receives new-suggestion notifications.

OWNER_NOTIFICATION_EMAIL=

# -----------------------------------------------------------------------------
# Site URL (Stage 7a)
# -----------------------------------------------------------------------------
# Used by the notify_owner Edge Function to build deep-links into the admin
# inbox (e.g. `${PUBLIC_SITE_URL}/admin/suggestions/<id>`).
#
# Local dev: http://localhost:4321
# Production: https://mapadeautoras.com

PUBLIC_SITE_URL=http://localhost:4321

# -----------------------------------------------------------------------------
# DeepL (Stage 7b-i)
# -----------------------------------------------------------------------------
# Used by supabase/functions/translate to power the "Traducir" button in the
# admin promote form. Free tier = 500k chars/month at api-free.deepl.com.
# Sign up at https://www.deepl.com/pro-api — pick the FREE plan.
# Without a key set, the button errors gracefully ("translation_failed") and
# the owner can type EN manually.

DEEPL_API_KEY=
