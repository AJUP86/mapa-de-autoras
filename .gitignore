.work*

# Agent scratch (task briefs, reports, the SDD progress ledger). Currently
# also excluded from most of that tree by a nested .superpowers/sdd/.gitignore,
# but that file is tool-generated — ignore the whole directory here too so it
# stays untracked if the nested file is ever removed.
.superpowers/

# Dependencies
node_modules/

# Build output
dist/
.astro/

# Local env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code local config (per-developer)
.claude/

# Supabase CLI artifacts (local-only state, never committed)
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/snippets/
