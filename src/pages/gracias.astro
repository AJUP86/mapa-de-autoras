---
import Base from "~/layouts/Base.astro";
import LanguageSwitch from "~/components/LanguageSwitch.astro";
import { t } from "~/i18n/t";

const lang = "es";
---

<Base lang={lang} title={`${t(lang, "suggest.thanks.title")} · ${t(lang, "meta.title")}`} description={t(lang, "suggest.thanks.body")}>
  <header class="mx-auto max-w-5xl px-6 pt-8 flex items-center justify-between">
    <a href="/" class="text-xs uppercase tracking-[0.18em] text-ink/50 font-body hover:text-oxblood">
      ← {t(lang, "nav.home")}
    </a>
    <LanguageSwitch lang={lang} />
  </header>

  <main class="mx-auto max-w-xl px-6 py-24 sm:py-32 text-center">
    <p class="text-sm uppercase tracking-[0.18em] text-ink/60 font-body mb-4">
      {t(lang, "suggest.eyebrow")}
    </p>
    <h1 class="font-display text-5xl sm:text-6xl font-semibold leading-[1.05] tracking-tight">
      {t(lang, "suggest.thanks.title")}
    </h1>
    <p class="mt-6 text-lg text-ink/75 font-body max-w-prose mx-auto">
      {t(lang, "suggest.thanks.body")}
    </p>
    <a
      href="/"
      class="
        inline-flex items-center justify-center mt-10
        rounded-lg bg-oxblood px-5 py-2.5
        text-parchment font-semibold font-body
        transition-colors hover:bg-oxblood/90
      "
    >
      {t(lang, "suggest.thanks.cta")}
    </a>
  </main>
</Base>
