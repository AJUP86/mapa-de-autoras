---
// src/pages/admin/suggestion.astro — Stage 7b-i (real review page)
import Base from "~/layouts/Base.astro";
import AdminGate from "~/components/AdminGate";
import SuggestionReview from "~/components/SuggestionReview";
import { t } from "~/i18n/t";

const lang = "es" as const;
const notAdminLabel = t(lang, "admin.login.error_not_admin");
const labels = {
  title: t(lang, "admin.review.title"),
  loading: t(lang, "admin.inbox.loading"),
  error: t(lang, "admin.inbox.error"),
  not_found: t(lang, "admin.review.not_found"),
  submitted_on: t(lang, "admin.review.submitted_on"),
  submitter: t(lang, "admin.review.submitter"),
  status: t(lang, "admin.review.status"),
  status_pending: t(lang, "admin.review.status_pending"),
  status_processed: t(lang, "admin.review.status_processed"),
  books_heading: t(lang, "admin.review.books_heading"),
  entry_author: t(lang, "admin.review.entry_author"),
  entry_country: t(lang, "admin.review.entry_country"),
  entry_book: t(lang, "admin.review.entry_book"),
  entry_note: t(lang, "admin.review.entry_note"),
  disp_pending: t(lang, "admin.review.disp_pending"),
  disp_promoted: t(lang, "admin.review.disp_promoted"),
  disp_rejected: t(lang, "admin.review.disp_rejected"),
  disp_already_present: t(lang, "admin.review.disp_already_present"),
  action_promote: t(lang, "admin.review.action_promote"),
  action_reject: t(lang, "admin.review.action_reject"),
  action_already_present: t(lang, "admin.review.action_already_present"),
  action_reopen: t(lang, "admin.review.action_reopen"),
  reject_reason_label: t(lang, "admin.review.reject_reason_label"),
  reject_confirm: t(lang, "admin.review.reject_confirm"),
  reject_cancel: t(lang, "admin.review.reject_cancel"),
  already_present_confirm: t(lang, "admin.review.already_present_confirm"),
  finish: t(lang, "admin.review.finish"),
  finish_hint_pending: t(lang, "admin.review.finish_hint_pending"),
  action_error: t(lang, "admin.review.action_error"),
  back_to_inbox: t(lang, "admin.review.back_to_inbox"),
};
---

<Base lang={lang} title={labels.title} noindex>
  <main class="min-h-screen bg-parchment p-6">
    <AdminGate client:load loginUrl="/admin" notAdminLabel={notAdminLabel}>
      <SuggestionReview client:load labels={labels} />
    </AdminGate>
  </main>
</Base>
