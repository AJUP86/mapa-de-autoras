---
import Base from "~/layouts/Base.astro";
import SuggestionForm from "~/components/SuggestionForm";
import { t } from "~/i18n/t";
import { getCountries } from "~/lib/countries";

const lang = "en";
const countries = await getCountries(lang);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const submitUrl = `${supabaseUrl}/functions/v1/submit_suggestion`;

const formLabels = {
  fields: {
    author_name_label: t(lang, "suggest.fields.author_name_label"),
    author_name_placeholder: t(lang, "suggest.fields.author_name_placeholder"),
    country_label: t(lang, "suggest.fields.country_label"),
    country_placeholder: t(lang, "suggest.fields.country_placeholder"),
    books_label: t(lang, "suggest.fields.books_label"),
    books_placeholder: t(lang, "suggest.fields.books_placeholder"),
    note_label: t(lang, "suggest.fields.note_label"),
    note_placeholder: t(lang, "suggest.fields.note_placeholder"),
    email_label: t(lang, "suggest.fields.email_label"),
    email_placeholder: t(lang, "suggest.fields.email_placeholder"),
    email_hint: t(lang, "suggest.fields.email_hint"),
    submitter_name_label: t(lang, "suggest.fields.submitter_name_label"),
    submitter_name_placeholder: t(lang, "suggest.fields.submitter_name_placeholder"),
    newsletter_label: t(lang, "suggest.fields.newsletter_label"),
  },
  submit: t(lang, "suggest.submit"),
  submitting: t(lang, "suggest.submitting"),
  errors: {
    network: t(lang, "suggest.errors.network"),
    validation: t(lang, "suggest.errors.validation"),
    turnstile: t(lang, "suggest.errors.turnstile"),
  },
  required_mark: t(lang, "suggest.required_mark"),
};
---

<Base lang={lang} title={`${t(lang, "suggest.title")} · ${t(lang, "meta.title")}`} description={t(lang, "suggest.intro")}>
  <main class="mx-auto max-w-2xl px-6 py-12 sm:py-16">
    <p class="text-sm uppercase tracking-[0.18em] text-ink/60 font-body mb-3">
      {t(lang, "suggest.eyebrow")}
    </p>
    <h1 class="font-display text-4xl sm:text-5xl font-semibold leading-[1.05] tracking-tight">
      {t(lang, "suggest.title")}
    </h1>
    <p class="mt-5 text-lg text-ink/75 max-w-prose font-body">
      {t(lang, "suggest.intro")}
    </p>

    <section class="mt-10">
      <SuggestionForm
        client:load
        labels={formLabels}
        countries={countries}
        locale={lang}
        turnstileSiteKey={turnstileSiteKey}
        submitUrl={submitUrl}
        thanksUrl="/en/thanks"
      />
    </section>
  </main>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</Base>
