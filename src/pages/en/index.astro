---
import Base from "~/layouts/Base.astro";
import LanguageSwitch from "~/components/LanguageSwitch.astro";
import MapSection from "~/components/MapSection";
import { t } from "~/i18n/t";

const lang = "en";

const mapLabels = {
  filter: {
    all: t(lang, "map.filter.all"),
    read: t(lang, "map.filter.read"),
    currently_reading: t(lang, "map.filter.currently_reading"),
    discoveries: t(lang, "map.filter.discoveries"),
  },
  panel: {
    close: t(lang, "map.panel.close"),
    empty: t(lang, "map.panel.empty"),
    suggest: t(lang, "map.panel.suggest"),
    booksLabel: t(lang, "map.panel.booksLabel"),
  },
  status: {
    read: t(lang, "map.status.read"),
    currently_reading: t(lang, "map.status.currently_reading"),
    discovery: t(lang, "map.status.discovery"),
  },
  view: {
    world: t(lang, "map.view.world"),
    europe: t(lang, "map.view.europe"),
    americas: t(lang, "map.view.americas"),
    africa: t(lang, "map.view.africa"),
    asia: t(lang, "map.view.asia"),
    oceania: t(lang, "map.view.oceania"),
  },
  zoom: {
    in: t(lang, "map.zoom.in"),
    out: t(lang, "map.zoom.out"),
    reset: t(lang, "map.zoom.reset"),
  },
};
---

<Base lang={lang} title={t(lang, "meta.title")} description={t(lang, "meta.description")}>
  <header class="mx-auto max-w-5xl px-6 pt-8 flex items-center justify-between">
    <span class="text-xs uppercase tracking-[0.18em] text-ink/50 font-body">
      {t(lang, "nav.home")}
    </span>
    <nav class="flex items-center gap-4">
      <a
        href="/en/suggest"
        class="text-xs uppercase tracking-[0.18em] text-ink/60 font-body hover:text-oxblood transition-colors"
      >
        {t(lang, "nav.suggest")}
      </a>
      <LanguageSwitch lang={lang} />
    </nav>
  </header>

  <section class="mx-auto max-w-3xl px-6 pt-16 pb-12 sm:pt-24 sm:pb-16">
    <p class="text-sm uppercase tracking-[0.18em] text-ink/60 mb-4 font-body">
      {t(lang, "hero.eyebrow")}
    </p>
    <h1 class="font-display text-5xl sm:text-7xl font-semibold leading-[1.05] tracking-tight">
      {t(lang, "hero.headlineA")}<br />{t(lang, "hero.headlineB")}
    </h1>
    <p class="mt-6 text-lg text-ink/75 max-w-prose font-body">
      {t(lang, "hero.subhead")}
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 pb-24">
    <div class="mb-8 text-center">
      <p class="text-xs uppercase tracking-[0.2em] text-ink/55 font-body mb-2">
        {t(lang, "map.eyebrow")}
      </p>
      <h2 class="font-display text-3xl sm:text-4xl font-semibold text-ink tracking-tight">
        {t(lang, "map.title")}
      </h2>
      <p class="mt-3 text-sm text-ink/70 font-body max-w-md mx-auto">
        {t(lang, "map.subhead")}
      </p>
    </div>

    <MapSection client:visible labels={mapLabels} />
  </section>
</Base>
