---
import Base from "../../layouts/Base.astro";
import LanguageSwitch from "../../components/LanguageSwitch.astro";
import { t } from "../../i18n/t";

const lang = "en";
---

<Base lang={lang} title={t(lang, "meta.title")} description={t(lang, "meta.description")}>
  <header class="mx-auto max-w-3xl px-6 pt-8 flex items-center justify-between">
    <span class="text-xs uppercase tracking-[0.18em] text-ink/50 font-body">
      {t(lang, "nav.home")}
    </span>
    <LanguageSwitch lang={lang} />
  </header>

  <main class="mx-auto max-w-3xl px-6 py-20 sm:py-32">
    <p class="text-sm uppercase tracking-[0.18em] text-ink/60 mb-4 font-body">
      {t(lang, "hero.eyebrow")}
    </p>
    <h1 class="font-display text-5xl sm:text-7xl font-semibold leading-[1.05] tracking-tight">
      {t(lang, "hero.headlineA")}<br />{t(lang, "hero.headlineB")}
    </h1>
    <p class="mt-6 text-lg text-ink/75 max-w-prose font-body">
      {t(lang, "hero.subhead")}
    </p>
    <p class="mt-10 text-sm text-ink/60 font-body">
      <em>{t(lang, "hero.construction")}</em>{" "}
      <a href="/styleguide" class="text-oxblood underline decoration-ochre decoration-2 underline-offset-4">
        {t(lang, "hero.styleguideLink")}
      </a>.
    </p>
  </main>
</Base>
