---
import Base from "~/layouts/Base.astro";
import { t } from "~/i18n/t";

const lang = "es";

// Sections rendered in order. Each pair -> heading + body.
const sections = [
  { titleKey: "privacy.collect_title", bodyKey: "privacy.collect_body" },
  { titleKey: "privacy.legal_basis_title", bodyKey: "privacy.legal_basis_body" },
  { titleKey: "privacy.retention_title", bodyKey: "privacy.retention_body" },
  { titleKey: "privacy.thirdparties_title", bodyKey: "privacy.thirdparties_body" },
  { titleKey: "privacy.cookies_title", bodyKey: "privacy.cookies_body" },
  { titleKey: "privacy.rights_title", bodyKey: "privacy.rights_body" },
  { titleKey: "privacy.contact_title", bodyKey: "privacy.contact_body" },
  { titleKey: "privacy.changes_title", bodyKey: "privacy.changes_body" },
] as const;

// Markdown-lite: **bold** -> <strong>, and paragraphs containing "- " become <ul>.
function renderBlock(body: string): string {
  const paragraphs = body.split("\n\n").map((p) => p.trim()).filter(Boolean);
  return paragraphs
    .map((p) => {
      const bolded = p.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
      // list block: lines starting with "- "
      if (bolded.split("\n").every((line) => line.startsWith("- "))) {
        const items = bolded
          .split("\n")
          .map((line) => `<li>${line.slice(2)}</li>`)
          .join("");
        return `<ul class="list-disc pl-6 space-y-1">${items}</ul>`;
      }
      // mixed lines with newlines -> convert to <br>
      const withBreaks = bolded.replace(/\n/g, "<br />");
      return `<p>${withBreaks}</p>`;
    })
    .join("");
}
---

<Base
  lang={lang}
  title={`${t(lang, "privacy.title")} · ${t(lang, "meta.title")}`}
  description={t(lang, "privacy.intro")}
>
  <main class="mx-auto max-w-2xl px-6 py-12 sm:py-16">
    <p class="text-sm uppercase tracking-[0.18em] text-ink/60 font-body mb-3">
      {t(lang, "privacy.eyebrow")}
    </p>
    <h1 class="font-display text-4xl sm:text-5xl font-semibold leading-[1.1] tracking-tight">
      {t(lang, "privacy.title")}
    </h1>
    <p class="mt-3 text-sm text-ink/55 font-body">
      {t(lang, "privacy.last_updated_label")} {t(lang, "privacy.last_updated")}
    </p>

    <div class="mt-8 text-lg text-ink/80 font-body max-w-prose" set:html={renderBlock(t(lang, "privacy.intro"))} />

    {sections.map(({ titleKey, bodyKey }) => (
      <section class="mt-10">
        <h2 class="font-display text-2xl font-semibold text-ink tracking-tight mb-4">
          {t(lang, titleKey)}
        </h2>
        <div class="space-y-4 text-base text-ink/80 font-body max-w-prose" set:html={renderBlock(t(lang, bodyKey))} />
      </section>
    ))}
  </main>
</Base>
