---
import "../styles/global.css";
import AdminAwareNav from "~/components/AdminAwareNav";
import { t } from "~/i18n/t";

interface Props {
  title?: string;
  description?: string;
  lang?: "es" | "en";
  noindex?: boolean;
}

const {
  title = "mapa de autoras",
  description = "Un mapa mundial de escritoras: autoras leídas y descubrimientos por descubrir.",
  lang = "es",
  noindex = false,
} = Astro.props;

// URL helpers — with prefixDefaultLocale: true, every public page lives at
// `/<locale>/<path>`. Admin pages under /admin/* stay outside the locale scheme.
const path = Astro.url.pathname;
const localePrefix = `/${lang}`;

// Derive the "path within the locale" — strip the current locale prefix.
// e.g. `/es/about` -> `/about`; `/en/thanks` -> `/thanks`; `/es/` -> `/`.
const pathWithinLocale = path.replace(/^\/(?:es|en)(\/|$)/, "/");

// Build hreflang alternates for the SAME page in each locale.
const esPath = `/es${pathWithinLocale === "/" ? "/" : pathWithinLocale}`;
const enPath = `/en${pathWithinLocale === "/" ? "/" : pathWithinLocale}`;

const site = Astro.site ?? new URL("http://localhost:4321/");
const esUrl = new URL(esPath, site).href;
const enUrl = new URL(enPath, site).href;

const isEn = lang === "en";

// Language switch: swap /es/... <-> /en/... on the current path.
// If we're on an admin page (/admin/*), the switch target defaults to the
// home page of the other locale (admin stays single-locale Spanish).
const isAdmin = path.startsWith("/admin");
const languageSwitchHref = isAdmin
  ? (isEn ? "/es/" : "/en/")
  : (isEn ? esPath : enPath);

const navLabels = {
  mapa: t(lang, "nav.home"),
  mapaHref: `${localePrefix}/`,
  sugerir: t(lang, "nav.suggest"),
  sugerirHref: `${localePrefix}/suggest`,
  books: t(lang, "nav.books"),
  booksHref: `${localePrefix}/books`,
  about: t(lang, "nav.about"),
  aboutHref: `${localePrefix}/about`,
  languageSwitchHref,
  languageSwitchLabel: isEn ? "ESPAÑOL" : "ENGLISH",
  languageSwitchAriaLabel: isEn ? "Cambiar a español" : "Switch to English",
  languageSwitchHreflang: isEn ? "es" : "en",
  sugerencias: t(lang, "admin.nav.sugerencias"),
  libros: t(lang, "admin.nav.libros"),
  anadir: t(lang, "admin.nav.anadir"),
  salir: t(lang, "admin.nav.salir"),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
  </head>
  <body class="font-body bg-parchment text-ink">
    <AdminAwareNav client:load labels={navLabels} />
    <slot />
  </body>
</html>
