---
import type { Lang } from "../i18n/t";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const path = Astro.url.pathname;

let target: string;
if (lang === "es") {
  target = path === "/" ? "/en/" : `/en${path}`;
} else {
  const stripped = path.replace(/^\/en(\/|$)/, "/");
  target = stripped === "" ? "/" : stripped;
}

const otherLabel = lang === "es" ? "ENGLISH" : "ESPAÑOL";
const ariaLabel = lang === "es" ? "Switch to English" : "Cambiar a español";
---

<a
  href={target}
  aria-label={ariaLabel}
  hreflang={lang === "es" ? "en" : "es"}
  class="inline-flex items-center justify-center rounded-full border border-ink/15 bg-bone px-3 py-1 text-xs font-medium tracking-wider text-ink/80 transition-colors hover:border-oxblood/40 hover:text-oxblood"
>
  {otherLabel}
</a>
