---
import Base from "~/layouts/Base.astro";
import SuggestionForm from "~/components/SuggestionForm";
import { suggestFormLabels } from "~/components/suggest-labels";
import { t } from "~/i18n/t";
import { getBuildCountries } from "~/lib/build-countries";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const countries = await getBuildCountries(lang);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const submitUrl = `${supabaseUrl}/functions/v1/submit_suggestion`;
const thanksUrl = `/${lang}/thanks`;

const formLabels = suggestFormLabels(lang);
---

<Base lang={lang} title={`${t(lang, "suggest.title")} · ${t(lang, "meta.title")}`} description={t(lang, "suggest.intro")}>
  <main class="mx-auto max-w-2xl px-6 py-12 sm:py-16">
    <p class="text-sm uppercase tracking-[0.18em] text-ink/60 font-body mb-3">
      {t(lang, "suggest.eyebrow")}
    </p>
    <h1 class="font-display text-4xl sm:text-5xl font-semibold leading-[1.05] tracking-tight">
      {t(lang, "suggest.title")}
    </h1>
    <p class="mt-5 text-lg text-ink/75 max-w-prose font-body">
      {t(lang, "suggest.intro")}
    </p>

    <section class="mt-10">
      <SuggestionForm
        client:load
        labels={formLabels}
        countries={countries}
        locale={lang}
        turnstileSiteKey={turnstileSiteKey}
        submitUrl={submitUrl}
        thanksUrl={thanksUrl}
      />
    </section>
  </main>

  <!-- Turnstile loader: async, only on this page. Renders the widget into the
       div the React island provides via window.turnstile.render(...). -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</Base>
