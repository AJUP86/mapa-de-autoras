---
// IndexPage.astro — Stage 11. The home as a landing page: hero (waitlist card
// before release, "Abrir el mapa" after), the build-time map picture, about
// Danny, how it works, a closing band and a small footer. The release phase is
// PUBLIC_MAP_OPEN (MAP_OPEN). The only island is the waitlist card.
import Base from "~/layouts/Base.astro";
import MapPicture from "~/components/home/MapPicture.astro";
import WaitlistCard from "~/components/WaitlistCard";
import { waitlistLabels } from "~/components/waitlist-labels";
import { IconArrowRight } from "~/components/icons";
import { STATUS_FILL } from "~/components/status-colors";
import type { Locale } from "~/i18n/locales";
import { t } from "~/i18n/t";
import { MAP_OPEN } from "~/lib/site-config";
import type { BookStatus } from "~/lib/map-state";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const mapHref = `/${lang}/map`;

// Same guard as AboutPage: link Instagram only once a real profile URL is set.
const instagramUrl = t(lang, "about.instagram_url");
const showInstagram = Boolean(instagramUrl) && instagramUrl !== "https://www.instagram.com/";

const steps = [t(lang, "home.how.step1"), t(lang, "home.how.step2"), t(lang, "home.how.step3")];
const statusDots: BookStatus[] = ["read", "reading", "to_read"];

const EYEBROW = "text-[0.72rem] font-medium uppercase tracking-[0.18em] text-ink/70";
const H2 =
  "mt-2 font-display text-[clamp(1.8rem,4vw,2.5rem)] font-semibold leading-[1.1] tracking-[-0.015em] text-ink";
const SECTION = "border-t border-ink/10 py-10 lg:py-14";
const TEXT_LINK =
  "inline-flex min-h-11 items-center font-medium text-oxblood underline decoration-ochre decoration-2 underline-offset-4 hover:text-oxblood-2";
---

<Base lang={lang} title={t(lang, "meta.title")} description={t(lang, "meta.description")}>
  <main class="mx-auto max-w-[1080px] px-4 sm:px-6">
    <section
      aria-labelledby="home-title"
      class="grid items-center gap-8 pt-7 pb-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-14 lg:pt-14 lg:pb-18"
    >
      <div>
        <p class={EYEBROW}>{t(lang, "home.eyebrow")}</p>
        <h1
          id="home-title"
          class="mt-4 font-display text-[clamp(2.7rem,7.2vw,5rem)] font-semibold leading-[1.02] tracking-[-0.012em] text-ink"
        >
          {t(lang, "home.title_a")}<br /><em class="font-medium italic text-oxblood">{t(lang, "home.title_b")}</em>
        </h1>
        <p class="mt-6 max-w-[33em] text-[1.14rem] text-ink/75">
          {`${t(lang, "home.lead")} ${t(lang, MAP_OPEN ? "home.lead_open" : "home.lead_soon")}`}
        </p>
      </div>

      {MAP_OPEN ? (
        <div class="lg:justify-self-center">
          <a
            href={mapHref}
            class="inline-flex h-12 items-center gap-2 rounded-full bg-oxblood px-6 font-semibold text-bone no-underline hover:bg-oxblood-2"
          >
            {t(lang, "home.open_map")}
            <IconArrowRight />
          </a>
        </div>
      ) : (
        <div id="waitlist" class="w-full max-w-[480px] scroll-mt-6 lg:max-w-none">
          <WaitlistCard client:load lang={lang} labels={waitlistLabels(lang)} />
        </div>
      )}
    </section>

    <section aria-labelledby="home-picture-title" class={SECTION}>
      <p class={EYEBROW}>{t(lang, "home.picture.eyebrow")}</p>
      <h2 id="home-picture-title" class={H2}>{t(lang, "home.picture.title")}</h2>
      <div class="mt-6">
        <MapPicture lang={lang} open={MAP_OPEN} />
      </div>
    </section>

    <section aria-labelledby="home-about-title" class={SECTION}>
      <div class="grid items-start gap-6 sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-10">
        {/* Placeholder until Danny sends a photo. */}
        <div
          aria-hidden="true"
          class="grid size-24 place-items-center rounded-full bg-oxblood font-display text-[2.6rem] leading-none font-semibold text-bone sm:size-32 sm:text-[3.4rem]"
        >
          D
        </div>
        <div>
          <p class={EYEBROW}>{t(lang, "home.about.eyebrow")}</p>
          <h2 id="home-about-title" class={H2}>{t(lang, "home.about.title")}</h2>
          <p class="mt-5 max-w-prose text-[1.05rem] text-ink/80">{t(lang, "home.about.body")}</p>
          <p class="mt-3 max-w-prose text-[1.05rem] font-medium text-ink">{t(lang, "home.about.followers")}</p>
          <div class="mt-3 flex flex-wrap gap-x-6">
            {showInstagram && (
              <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class={TEXT_LINK}>
                {t(lang, "home.about.instagram")}
              </a>
            )}
            <a href={`/${lang}/about`} class={TEXT_LINK}>{t(lang, "home.about.more")}</a>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="home-how-title" class={SECTION}>
      <p class={EYEBROW}>{t(lang, "home.how.eyebrow")}</p>
      <h2 id="home-how-title" class={H2}>{t(lang, "home.how.title")}</h2>
      {/* role="list": Safari drops list semantics from unstyled lists. */}
      <ol role="list" class="mt-7 grid gap-6 sm:grid-cols-3 sm:gap-8">
        {steps.map((step, i) => (
          <li class="flex gap-4 sm:flex-col sm:gap-3">
            <span
              aria-hidden="true"
              class="grid size-10 flex-none place-items-center rounded-full bg-ink font-display text-lg font-semibold text-bone"
            >
              {i + 1}
            </span>
            <p class="pt-1.5 text-[1.05rem] text-ink/80 sm:pt-0">
              {step}
              {i === 1 && (
                <span aria-hidden="true" class="ml-1 inline-flex gap-1 align-middle">
                  {statusDots.map((s) => (
                    <span class={`size-2.5 rounded-full ${STATUS_FILL[s]}`} title={t(lang, `map.status.${s}`)} />
                  ))}
                </span>
              )}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="home-closing-title" class={SECTION}>
      <div class="flex flex-wrap items-center justify-between gap-6 rounded-[20px] bg-ink p-6 text-bone sm:p-8">
        <h2 id="home-closing-title" class="font-display text-[1.8rem] leading-[1.15] font-semibold text-bone">
          {t(lang, MAP_OPEN ? "home.closing.open_title" : "home.closing.soon_title")}
        </h2>
        <a
          href={MAP_OPEN ? mapHref : "#waitlist"}
          class="inline-flex h-12 items-center gap-2 rounded-full bg-bone px-6 font-semibold text-ink no-underline hover:bg-parchment focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ochre"
        >
          {t(lang, MAP_OPEN ? "home.open_map" : "home.closing.soon_cta")}
          {MAP_OPEN && <IconArrowRight />}
        </a>
      </div>
    </section>
  </main>

  <footer class="mx-auto max-w-[1080px] px-4 sm:px-6">
    <div class="flex flex-wrap gap-x-6 border-t border-ink/10 pt-3 pb-10 text-[0.9rem]">
      <a href={`/${lang}/about`} class="inline-flex min-h-11 items-center text-ink/75 hover:text-oxblood">
        {t(lang, "nav.about")}
      </a>
      <a href={`/${lang}/privacy`} class="inline-flex min-h-11 items-center text-ink/75 hover:text-oxblood">
        {t(lang, "home.footer.privacy")}
      </a>
      {showInstagram && (
        <a
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center text-ink/75 hover:text-oxblood"
        >
          {t(lang, "about.instagram_label")}
        </a>
      )}
    </div>
  </footer>
</Base>
