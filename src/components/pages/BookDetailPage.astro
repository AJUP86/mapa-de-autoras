---
import Base from "~/layouts/Base.astro";
import BookDetail from "~/components/BookDetail";
import { bookDetailLabels } from "~/components/book-labels";
import { t } from "~/i18n/t";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const labels = bookDetailLabels(lang);
---

<Base
  lang={lang}
  title={`${t(lang, "books.title")} · ${t(lang, "meta.title")}`}
  description={t(lang, "books.intro")}
>
  <main class="mx-auto max-w-3xl px-6 py-12 sm:py-16">
    <BookDetail
      client:load
      lang={lang}
      labels={labels}
      listHref={`/${lang}/map?view=list`}
      siteTitle={t(lang, "meta.title")}
    />
  </main>
</Base>
