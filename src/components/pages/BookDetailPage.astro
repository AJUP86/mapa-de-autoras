---
import Base from "~/layouts/Base.astro";
import BookDetail from "~/components/BookDetail";
import { BOOK_MAIN_CLASS, bookDetailProps } from "~/components/page-props";
import { t } from "~/i18n/t";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

// Same props as the closed page's admin layer (AdminBook).
const props = bookDetailProps(lang);
---

<Base
  lang={lang}
  title={`${t(lang, "books.title")} · ${t(lang, "meta.title")}`}
  description={t(lang, "books.intro")}
>
  <main class={BOOK_MAIN_CLASS}>
    <BookDetail client:load {...props} />
  </main>
</Base>
